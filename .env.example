# 宿主机端口，只绑定 127.0.0.1 给本机 OpenResty 反代；容器内固定 5001
HOST_PORT=5001

# 宿主机上的照片目录（会递归扫描子文件夹）；照片全在对象存储时放一个空目录
PHOTOS_DIR=./photos

# 索引和缩略图存放位置
DATA_DIR=./data

# 对象存储不在这里配置：登录后在网页左侧「设置」里添加，可添加多个

# 日志时间，以及「自动」显示模式按此时区判断白天/黑夜（6:00–18:00 为白天）
TZ=Asia/Shanghai

# 登录账号，不设置则服务不会启动
AUTH_USER=juen
AUTH_PASS=changeme

# 同时生成缩略图的张数；留空按 CPU 数自动取约三分之二
THUMB_WORKERS=4

# 对象存储上传通知（RustFS webhook）。两项都填才开启；开启后新照片几秒内入库，
# 定时扫描默认放宽到 30 分钟。EVENTS_TOKEN 至少 16 位，与 RustFS 端填写的令牌相同。
EVENTS_LISTEN=
EVENTS_TOKEN=

# 自动扫描间隔，最短 10 秒；留空时未开通知为 2 分钟，开通知为 30 分钟
SCAN_EVERY=

# 容器资源上限（netcup 8 核 / 15 GB 的取值）
CPUS=6
MEM_LIMIT=4g
GOMEMLIMIT=3GiB
