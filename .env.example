# 宿主机端口，容器内固定 5001
HOST_PORT=5001

# 宿主机上的照片目录（会递归扫描子文件夹）
PHOTOS_DIR=./photos

# 索引和缩略图存放位置
DATA_DIR=./data

# 图片来源：local 只扫描上面的 PHOTOS_DIR；s3 在本地图库基础上再合并下方 S3 图片
STORAGE_BACKEND=local

# S3 兼容对象存储（仅 STORAGE_BACKEND=s3 时必填）
# endpoint 可写 https://s3.example.com，也可写 s3.example.com 并由 S3_USE_SSL 决定协议
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
# 可选，只扫描 bucket 中此前缀下的对象，例如 photos/2026
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# 日志时间，以及「自动」显示模式按此时区判断白天/黑夜（6:00–18:00 为白天）
TZ=Asia/Shanghai

# 登录账号，不设置则服务不会启动
AUTH_USER=juen
AUTH_PASS=changeme
